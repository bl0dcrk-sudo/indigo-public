<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:versionCode="1" android:versionName="1.0" package="com.indigo.nfs2se">
  <uses-sdk android:minSdkVersion="24" />
  <uses-feature android:glEsVersion="0x00020000" android:required="true" />
  <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- The game reads its data with plain File IO from any folder the user picks (internal storage, SD card): Android 11+ needs
       "All files access" (sideloaded APK, not Play Store); older versions the classic read permission. -->
  <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
  <!-- enableOnBackInvokedCallback=false: the system Back button keeps arriving as OnBackPressed / KEYCODE_BACK (MainActivity turns
       it into PlatformBack.Request, which opens the pause menu), not as a predictive-back gesture the game would never see.
       Without the permission the app's own external files dir (adb push) still works. -->
  <application android:label="Indigo (NFS2SE)" android:allowBackup="false" android:enableOnBackInvokedCallback="false" android:hardwareAccelerated="true">
  </application>
</manifest>
